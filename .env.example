# Copy to .env.local and adjust. .env.local is gitignored.

# Base URL of the ASP.NET backend, WITHOUT the trailing /api segment.
# lib/api/client.ts appends /api itself (backend routes are api/[controller]).
# Leave empty while running on mocks.
NEXT_PUBLIC_API_URL=

# Mock data switch for the lib/api layer.
# Defaults to mocks ON: any value other than "false" keeps mocks enabled,
# so the app runs with zero backend setup. Set to false to hit the real API.
NEXT_PUBLIC_USE_MOCKS=true

# Public origin of the deployed site, used as metadataBase so OG/canonical URLs
# resolve absolutely. Optional — falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Extra origin allowed to reach the dev server (Next allowedDevOrigins),
# e.g. a LAN/Radmin IP used to open the site from another device.
# Optional — omit when developing on localhost only.
DEV_ORIGIN=
